BACKEND_URL=http://localhost:3001

# --- Authentification (Auth.js + Google) -----------------------------------
# Chiffre le cookie de session. Générer avec : openssl rand -hex 32
AUTH_SECRET=

# Client OAuth « Application Web » créé dans la Google Cloud Console
# (API et services → Identifiants). URI de redirection autorisée à déclarer :
#   http://localhost:3000/api/auth/callback/google      (développement)
#   https://<domaine public>/api/auth/callback/google   (production, HTTPS requis)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Adresses autorisées, séparées par des virgules. Vide = tout compte Google
# à l'adresse vérifiée (déconseillé si l'application est joignable d'Internet).
AUTH_ALLOWED_EMAILS=

# URL publique. Obligatoire en production, en HTTPS : elle fait poser des
# cookies Secure (__Secure- / __Host-), jamais envoyés en HTTP clair.
# Inutile en développement sur http://localhost:3000.
# AUTH_URL=https://prix.example.fr

# Secret partagé avec le backend (même valeur que BACKEND_AUTH_SECRET côté
# backend) : signe le jeton qui porte l'identité de l'utilisateur.
BACKEND_AUTH_SECRET=dev-secret-change-me-dev-secret-change-me
