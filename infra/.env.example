# Copier en .env (jamais commité) et ajuster les valeurs avant `docker compose up`.

# --- MongoDB ---
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password
MONGODB_URI=mongodb://admin:password@mongodb:27017/scrapper?authSource=admin

# --- Postgres (metadata Airflow) ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow

# --- Airflow ---
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=

# Orchestrateur utilisé par le DAG pour lancer scrape/refine/train/score : "docker" en local (DockerOperator),
# "kubernetes" en cluster (KubernetesPodOperator, voir k8s/).
PIPELINE_EXECUTOR=docker

# Préfixe des images poussées par la CI (ghcr.io/<owner>/item_scrapper-<service>)
IMAGE_REGISTRY=ghcr.io/YOUR_GITHUB_USERNAME/item_scrapper

# GID du groupe "docker" sur l'hôte (stat -c '%g' /var/run/docker.sock), nécessaire au scheduler
# pour lancer des conteneurs sibling via DockerOperator.
DOCKER_GID=984

# Alerte de réapprovisionnement carburant (optionnelle) : à chaque import, un
# webhook signé part vers l'agent (Hermes) quand un carburant surveillé redevient
# disponible dans une station favorite (étoile sur la carte des carburants) ou,
# si elle est définie, dans la zone. Sans webhook ni zone, rien n'est fait.
# Cf. pipeline/src/fuel/restock_alerts.py.
# URL joignable depuis le conteneur/Pod du pipeline (pas localhost).
# FUEL_RESTOCK_WEBHOOK_URL=http://192.168.1.10:8644/webhooks/fuel-restock
# Même valeur que le `secret` de la route Hermes. Générer avec : openssl rand -hex 32
# FUEL_RESTOCK_WEBHOOK_SECRET=CHANGEME
# FUEL_WATCH_FUELS=gazole
# Zone facultative, en plus des favorites (sans elle : favorites seulement).
# FUEL_WATCH_LAT=45.75938
# FUEL_WATCH_LNG=4.85491
# FUEL_WATCH_RADIUS_KM=5
