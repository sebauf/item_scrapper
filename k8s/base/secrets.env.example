# Copier en secrets.env (jamais commité, ignoré par git) à côté de ce fichier,
# puis ajuster les valeurs avant de lancer `kubectl apply -k k8s/overlays/prod`.
# kustomize en fait un Secret "price-tracker-secrets" (cf. base/kustomization.yaml).

# MongoDB applicatif (déployé par k8s/base/mongodb.yaml)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=CHANGEME
# Doit reprendre les mêmes valeurs que ci-dessus :
# mongodb://<MONGO_ROOT_USERNAME>:<MONGO_ROOT_PASSWORD>@mongodb:27017/scrapper?authSource=admin
MONGODB_URI=mongodb://admin:CHANGEME@mongodb:27017/scrapper?authSource=admin

# Jeton porteur du serveur MCP — c'est la seule protection de l'Ingress /mcp,
# qui expose des outils d'écriture. Minimum 16 caractères, à recopier dans la
# configuration de l'agent. Générer avec : openssl rand -hex 32
MCP_AUTH_TOKEN=CHANGEME

# --- Authentification -------------------------------------------------------
# Secret frontend → backend : signe le jeton interne qui porte l'identité de
# l'utilisateur à chaque appel d'API. Générer avec : openssl rand -hex 32
BACKEND_AUTH_SECRET=CHANGEME
# Secret MCP → backend, DIFFÉRENT du précédent : le backend ne l'accepte que
# pour MCP_USER_EMAIL. Générer avec : openssl rand -hex 32
MCP_BACKEND_AUTH_SECRET=CHANGEME
# Chiffre le cookie de session du frontend (Auth.js). openssl rand -hex 32
AUTH_SECRET=CHANGEME
# Client OAuth Google « Application Web » (Google Cloud Console → Identifiants).
# URI de redirection autorisée : https://<domaine public>/api/auth/callback/google
AUTH_GOOGLE_ID=CHANGEME.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=CHANGEME
# Adresses autorisées, séparées par des virgules. Vide = tout compte Google
# vérifié — à éviter : l'application est derrière un Ingress.
AUTH_ALLOWED_EMAILS=moi@gmail.com
# URL publique du frontend, en HTTPS (obligatoire) : URL de rappel OAuth et
# cookies `Secure`. Doit correspondre au domaine déclaré chez Google.
AUTH_URL=https://prix.example.fr
# Compte qui reçoit, au démarrage du backend, les mots-clés, favoris, URLs
# suivies et stations favorites créés avant l'authentification (facultatif).
AUTH_LEGACY_OWNER_EMAIL=moi@gmail.com
# Compte au nom duquel agit le serveur MCP (ses mots-clés, ses favoris).
MCP_USER_EMAIL=moi@gmail.com

# Metadata DB d'Airflow (Postgres déployé par k8s/base/postgres.yaml)
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=CHANGEME
# Doit reprendre les mêmes valeurs que ci-dessus :
# postgresql+psycopg2://<AIRFLOW_DB_USER>:<AIRFLOW_DB_PASSWORD>@airflow-postgres/airflow
AIRFLOW_SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:CHANGEME@airflow-postgres/airflow

# Compte admin créé dans la webui Airflow par le Job airflow-init
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=CHANGEME

# Générer avec : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=CHANGEME
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_SECRET_KEY=CHANGEME

# Alerte de réapprovisionnement carburant (optionnelle), par utilisateur : à
# chaque import, un webhook signé part vers l'agent (Hermes) pour chaque
# utilisateur dont un carburant surveillé redevient disponible dans une de ses
# stations favorites. Stations (étoile sur la carte), carburants et numéro de
# téléphone se règlent dans l'application (page Profil) ; le corps du webhook
# porte le numéro dans `to` (E.164) et le message dans `summary`. Route Hermes :
#   deliver: sms   deliver_only: true   prompt: "{summary}"
#   deliver_extra: { chat_id: "{to}" }
# Pour WhatsApp : deliver: whatsapp, chat_id: "{whatsappChatId}"
# (`33612345678@s.whatsapp.net`, forme attendue par le pont de Hermes).
# Sans webhook, rien n'est fait. Cf. pipeline/src/fuel/restock_alerts.py.
# URL joignable depuis le conteneur/Pod du pipeline (pas localhost).
# FUEL_RESTOCK_WEBHOOK_URL=http://192.168.1.10:8644/webhooks/fuel-restock
# Obligatoire avec l'URL : sans signature, n'importe qui pourrait faire envoyer
# un message à n'importe quel numéro. Même valeur que le `secret` de la route
# Hermes. Générer avec : openssl rand -hex 32
# FUEL_RESTOCK_WEBHOOK_SECRET=CHANGEME
