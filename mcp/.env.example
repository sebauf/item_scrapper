# Racine de l'API backend, sans /api/v1 — le client l'ajoute.
BACKEND_URL=http://localhost:3001

# Port d'écoute du serveur MCP.
PORT=3010

# Jeton porteur exigé sur /mcp (en-tête « Authorization: Bearer … »).
# Minimum 16 caractères. Générer avec : openssl rand -hex 32
MCP_AUTH_TOKEN=

# Ouvre le serveur sans authentification. Le serveur refuse de démarrer si ni
# MCP_AUTH_TOKEN ni cette variable ne sont renseignées : l'anonymat doit être un
# choix, jamais un oubli. À réserver au développement local.
MCP_ALLOW_ANONYMOUS=false

# Délai au-delà duquel un appel au backend est abandonné (ms).
BACKEND_TIMEOUT_MS=10000

# Hôtes acceptés dans l'en-tête Host, séparés par des virgules. Vide (défaut) =
# protection anti-DNS rebinding désactivée. À renseigner avec le nom d'hôte réel
# de l'ingress une fois qu'il est connu.
MCP_ALLOWED_HOSTS=
