{
  "name": "item-scrapper-backend",
  "version": "1.0.0",
  "description": "API backend (NestJS) — seul point d'accès aux données du price tracker",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "mongodb": "^6.8.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.28",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.0"
  },
  "//overrides": "Remontées transitives corrigeant des advisories npm audit (find-my-way DoS HTTP/2, js-yaml DoS, @fastify/static path traversal). Portées au paquet parent pour ne pas casser les autres consommateurs (ts-jest dépend de js-yaml 3.x). Le cas @fastify/static élargit en plus le peer de platform-fastify, resté en ^8||^9 alors que seul le 10.1.3 est corrigé ; @nestjs/swagger accepte déjà ^10 et c'est lui qui s'en sert (assets de /docs).",
  "overrides": {
    "@nestjs/platform-fastify": {
      "find-my-way": "^9.7.0",
      "@fastify/static": "^10.1.3"
    },
    "fastify": {
      "find-my-way": "^9.7.0"
    },
    "@nestjs/swagger": {
      "js-yaml": "^5.2.3"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "testEnvironment": "node"
  }
}
