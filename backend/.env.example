MONGODB_URI=mongodb://admin:password@localhost:27017/scrapper?authSource=admin
PORT=3001
# Origines autorisées pour CORS, séparées par des virgules. Vide = CORS désactivé,
# ce qui est le mode nominal : le frontend appelle le backend côté serveur.
CORS_ORIGINS=
# URI utilisée par les tests d'intégration. Si absente, ils sont ignorés.
MONGODB_TEST_URI=mongodb://admin:password@localhost:27017/scrapper_test?authSource=admin
