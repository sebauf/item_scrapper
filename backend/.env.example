MONGODB_URI=mongodb://admin:password@localhost:27017/scrapper?authSource=admin
PORT=3001
# Origines autorisées pour CORS, séparées par des virgules. Vide = CORS désactivé,
# ce qui est le mode nominal : le frontend appelle le backend côté serveur.
CORS_ORIGINS=
# URI utilisée par les tests d'intégration. Si absente, ils sont ignorés.
MONGODB_TEST_URI=mongodb://admin:password@localhost:27017/scrapper_test?authSource=admin

# Secret HMAC du frontend : il signe le jeton qui porte l'identité de
# l'utilisateur à chaque appel. Même valeur côté frontend. 32 caractères
# minimum. Générer avec : openssl rand -hex 32
# Pour appeler l'API à la main : npm run token -- moi@gmail.com
BACKEND_AUTH_SECRET=dev-secret-change-me-dev-secret-change-me

# Adresse Google à qui rattacher, au démarrage, les données créées avant
# l'authentification (mots-clés, favoris, URLs suivies, stations favorites).
# Idempotent. Vide = rien n'est rattaché, ces données restent invisibles.
AUTH_LEGACY_OWNER_EMAIL=

# Secret propre au serveur MCP (même valeur côté MCP), DIFFÉRENT du précédent :
# il ne permet d'agir qu'au nom de MCP_USER_EMAIL. Vide = jetons du MCP refusés.
MCP_BACKEND_AUTH_SECRET=
MCP_USER_EMAIL=

# Quotas par utilisateur (0 = illimité). Le budget de crawl est commun :
# ~155 requêtes par mot-clé au pire, 1 par URL suivie, sur MAX_REQUESTS_PER_CRAWL
# (1000) côté scrapper.
MAX_KEYWORDS_PER_USER=10
MAX_TRACKED_URLS_PER_USER=100
